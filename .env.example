# ===========================================
# Housing MLOps Project - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# Model Configuration
MODEL_NAME=housing_price_predictor
MODEL_VERSION=latest

# MLflow Configuration
MLFLOW_TRACKING_URI=file:///app/mlruns
MLFLOW_EXPERIMENT_NAME=housing_price_prediction

# Data Paths (inside container)
DATA_PATH=/app/data/raw/house_prices.csv
PROCESSED_DATA_PATH=/app/data/processed/

# API Configuration
TRAINING_API_HOST=training-service
TRAINING_API_PORT=8000
DJANGO_PORT=8080

# Training Hyperparameters
RANDOM_SEED=42
TEST_SIZE=0.2
N_ESTIMATORS=100
MAX_DEPTH=15

# Django
DJANGO_SECRET_KEY=your-secret-key-change-in-production
DJANGO_DEBUG=True
